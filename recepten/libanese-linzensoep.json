  "bereiding": [
    {
      "onderdeel": "Basis",
      "stap": 1,
      "tekst": "Kies Sauté. Bak de 2 uien en de wortel in 3 el olijfolie 8–10 minuten tot de ui goudbruin is; roer af en toe."
    },
    {
      "onderdeel": "Basis",
      "stap": 2,
      "tekst": "Voeg 4 tenen knoflook toe en bak 1–2 minuten mee."
    },
    {
      "onderdeel": "Basis",
      "stap": 3,
      "tekst": "Voeg 2 tl gemalen komijn en ¼ tl gemalen chilipeper toe en roer 30–60 seconden tot de specerijen geuren."
    },
    {
      "onderdeel": "Basis",
      "stap": 4,
      "tekst": "Voeg 142 g tomatenpuree toe en bak al roerend 1 minuut mee."
    },
    {
      "onderdeel": "Onder druk garen",
      "stap": 5,
      "tekst": "Blus af met een scheut van de 1.560 ml groentebouillon en schraap de bodem schoon. Voeg de rest van de bouillon, 190 g linzen, 65 g rijst en 1 tl gedroogde peterselie toe en roer."
    },
    {
      "onderdeel": "Onder druk garen",
      "stap": 6,
      "tekst": "Sluit het deksel, zet het ventiel op Sealing en kies Pressure Cook / High, 5 minuten. Druk opbouwen duurt circa 10–15 minuten."
    },
    {
      "onderdeel": "Onder druk garen",
      "stap": 7,
      "tekst": "Laat 10 minuten natuurlijk druk afbouwen; laat daarna de resterende druk voorzichtig ontsnappen."
    },
    {
      "onderdeel": "Afwerken",
      "stap": 8,
      "tekst": "Kies Cancel en pureer met een staafmixer in de binnenpan circa 2–3 minuten helemaal glad."
    },
    {
      "onderdeel": "Afwerken",
      "stap": 9,
      "tekst": "Roer het sap van ½ citroen erdoor en breng op smaak met zout, zwarte peper en eventueel meer gemalen chilipeper."
    }
  ]
}
